# Must match the JWT_SECRET in your MUF Engine deployment's .env
JWT_SECRET=change-this-to-a-strong-secret-min-32-chars

# Backend port (frontend's proxy expects 4000)
PORT=4000

# CORS allowlist — comma-separated front-end origins allowed to call the mint
# endpoints. NEVER use a wildcard in production. Defaults to the dev front-end.
ALLOWED_ORIGINS=http://localhost:5173
