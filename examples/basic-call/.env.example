# Copy to .env.local and adjust. The browser NEVER holds your org key —
# it only calls your backend's token-mint endpoints, which sign short-lived
# room tokens server-side. See examples/sample-integration/backend for a
# reference token backend exposing /api/host-token and /api/viewer-token.
VITE_SIGNALING_HOST=wss://signal.your-domain.com/ws
VITE_TOKEN_BACKEND=/api/host-token
VITE_VIEWER_TOKEN_BACKEND=/api/viewer-token
